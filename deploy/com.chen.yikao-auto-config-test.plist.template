<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.chen.yikao-auto-config-test</string>

    <key>ProgramArguments</key>
    <array>
      <string>/bin/bash</string>
      <string>__YIKAO_TEST_APP_DIR__/scripts/run_test_service.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__YIKAO_TEST_APP_DIR__</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>__YIKAO_TEST_ROOT__/logs/service.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>__YIKAO_TEST_ROOT__/logs/service.stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
      <key>YIKAO_TEST_ROOT</key>
      <string>__YIKAO_TEST_ROOT__</string>
      <key>CODEX_NODE</key>
      <string>__YIKAO_TEST_NODE__</string>
      <key>CODEX_PYTHON</key>
      <string>__YIKAO_TEST_PYTHON__</string>
    </dict>
  </dict>
</plist>

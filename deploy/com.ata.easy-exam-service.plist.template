<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ata.easy-exam-service</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__EASY_EXAM_APP_DIR__/scripts/run_local_service.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__EASY_EXAM_APP_DIR__</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__EASY_EXAM_RUNTIME_DIR__/logs/service.stdout.log</string>

  <key>StandardErrorPath</key>
  <string>__EASY_EXAM_RUNTIME_DIR__/logs/service.stderr.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PORT</key>
    <string>8765</string>
    <key>CODEX_NODE</key>
    <string>__EASY_EXAM_NODE__</string>
    <key>CODEX_PYTHON</key>
    <string>__EASY_EXAM_PYTHON__</string>
  </dict>
</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ata.easy-exam-wechat-collector</string>

  <key>ProgramArguments</key>
  <array>
    <string>__EASY_EXAM_NODE__</string>
    <string>__EASY_EXAM_APP_DIR__/scripts/wechat_visible_collect.mjs</string>
    <string>--config</string>
    <string>__EASY_EXAM_RUNTIME_DIR__/wechat-requirement-groups.json</string>
    <string>--state</string>
    <string>__EASY_EXAM_RUNTIME_DIR__/wechat-checkpoints.json</string>
    <string>--push</string>
    <string>--api</string>
    <string>http://127.0.0.1:8765</string>
    <string>--captureMode</string>
    <string>ocr</string>
    <string>--output</string>
    <string>__EASY_EXAM_RUNTIME_DIR__/wechat-last-run.json</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__EASY_EXAM_APP_DIR__</string>

  <key>StartInterval</key>
  <integer>900</integer>

  <key>StandardOutPath</key>
  <string>__EASY_EXAM_RUNTIME_DIR__/wechat-collector.log</string>

  <key>StandardErrorPath</key>
  <string>__EASY_EXAM_RUNTIME_DIR__/wechat-collector.err.log</string>
</dict>
</plist>
